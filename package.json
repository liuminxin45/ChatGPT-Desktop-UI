{
  "name": "chatgpt-desktop-kit",
  "version": "0.4.1",
  "description": "Reusable neutral desktop UI primitives, shell patterns, visual references and an agent skill.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./compat/*": {
      "types": "./dist/compat/*.d.ts",
      "import": "./dist/compat/*.js",
      "default": "./dist/compat/*.js"
    },
    "./source/*": "./src/*",
    "./controls.css": "./dist/controls.css",
    "./tokens.css": "./dist/tokens.css",
    "./primitives.css": "./dist/primitives.css",
    "./host.css": "./dist/compat/host.css",
    "./fixed-virtual-list": {
      "types": "./dist/fixed-virtual-list.d.ts",
      "import": "./dist/fixed-virtual-list.js",
      "default": "./dist/fixed-virtual-list.js"
    },
    "./host-shell.css": "./dist/compat/host-shell.css",
    "./tab-navigation": {
      "types": "./dist/tab-navigation.d.ts",
      "import": "./dist/tab-navigation.js",
      "default": "./dist/tab-navigation.js"
    },
    "./integration-check": {
      "types": "./dist/check-consumer.d.mts",
      "import": "./dist/check-consumer.mjs",
      "default": "./dist/check-consumer.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE.md",
    "licenses"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.gallery.json --noEmit",
    "build": "node scripts/build.mjs",
    "gallery": "node scripts/serve.mjs",
    "demo": "node scripts/build-site.mjs && node scripts/serve-demo.mjs",
    "demo:build": "node scripts/build-site.mjs",
    "demo:serve": "node scripts/serve-demo.mjs",
    "test:demo": "node scripts/verify-demo.mjs",
    "test:polish": "node scripts/verify-client-polish.mjs",
    "test": "node scripts/verify.mjs",
    "test:input": "node scripts/verify-input.mjs",
    "test:icons": "node scripts/verify-icon-actions.mjs",
    "test:namespace": "node scripts/verify-namespace.mjs",
    "skill:package": "node scripts/package-skill.mjs",
    "skill:check": "node scripts/check-skill.mjs",
    "skill:install": "node scripts/package-skill.mjs --install",
    "prepare": "npm run build:library",
    "build:library": "node scripts/build.mjs --library-only",
    "audit:public": "node scripts/audit-public.mjs",
    "test:integration": "node --test tests/integration-check.test.mjs",
    "test:public-install": "node scripts/verify-public-install.mjs",
    "docs:generate": "node scripts/component-catalog.mjs",
    "docs:check": "node scripts/component-catalog.mjs --check",
    "check:library": "node scripts/check-library.mjs",
    "audit:adoption": "node scripts/audit-adoption.mjs",
    "reference:build": "node scripts/build-catalog.mjs",
    "site:build": "node scripts/build-site.mjs",
    "test:reference": "node scripts/verify-reference.mjs",
    "format:check": "prettier --check src/components examples/catalog \"scripts/{component-catalog,audit-adoption,check-library,build-catalog,build-site,verify-reference}.mjs\"",
    "check": "npm run typecheck && npm run build:library && npm run docs:check && npm run check:library && npm run format:check && npm run test:namespace && npm run test:integration",
    "ci": "npm run check && npm run site:build && npm run test:reference && npm test && npm run test:demo && npm run test:polish && npm run test:input && npm run test:icons && npm run skill:package && npm run skill:check && npm run audit:public"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tanstack/react-virtual": "3.13.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "0.487.0",
    "react-day-picker": "8.10.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  }
}
