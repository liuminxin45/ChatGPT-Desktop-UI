{
  "name": "chatgpt-desktop-kit",
  "version": "0.8.6",
  "description": "ChatGPT desktop UI controls, semantic tokens, measured reference profiles and an agent skill.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./compat/*": {
      "types": "./dist/compat/*.d.ts",
      "import": "./dist/compat/*.js",
      "default": "./dist/compat/*.js"
    },
    "./source/*": "./src/*",
    "./controls.css": "./dist/controls.css",
    "./tokens.css": "./dist/tokens.css",
    "./primitives.css": "./dist/primitives.css",
    "./fixed-virtual-list": {
      "types": "./dist/fixed-virtual-list.d.ts",
      "import": "./dist/fixed-virtual-list.js",
      "default": "./dist/fixed-virtual-list.js"
    },
    "./tab-navigation": {
      "types": "./dist/tab-navigation.d.ts",
      "import": "./dist/tab-navigation.js",
      "default": "./dist/tab-navigation.js"
    },
    "./integration-check": {
      "types": "./dist/check-consumer.d.mts",
      "import": "./dist/check-consumer.mjs",
      "default": "./dist/check-consumer.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./adoption-audit": "./dist/audit-controls.mjs",
    "./shell.css": "./dist/shell.css",
    "./components.css": "./dist/components.css",
    "./desktop.css": "./dist/desktop.css"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE.md",
    "licenses",
    "!src/**/*.test.tsx"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": "^22.23.3 || ^24.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.gallery.json --noEmit",
    "build": "node scripts/build.mjs",
    "gallery": "node scripts/serve.mjs",
    "demo": "node scripts/build-site.mjs && node scripts/serve-demo.mjs",
    "demo:build": "node scripts/build-site.mjs",
    "demo:serve": "node scripts/serve-demo.mjs",
    "test:demo": "node scripts/verify-demo.mjs",
    "test:polish": "node scripts/verify-client-polish.mjs",
    "test": "node scripts/verify.mjs",
    "test:composer": "node scripts/verify-composer-actions.mjs",
    "test:composer-integration": "node scripts/verify-composer-integration.mjs",
    "test:input": "node scripts/verify-input.mjs",
    "test:temporal": "node scripts/verify-temporal.mjs",
    "test:menus": "node scripts/verify-menu-focus.mjs",
    "test:record-actions": "node scripts/verify-record-actions.mjs",
    "test:list-spacing": "node scripts/verify-list-spacing.mjs",
    "test:icons": "node scripts/verify-icon-actions.mjs",
    "test:namespace": "node scripts/verify-namespace.mjs",
    "skill:package": "node scripts/package-skill.mjs",
    "skill:check": "node scripts/check-skill.mjs",
    "skill:install": "node scripts/package-skill.mjs --install",
    "prepare": "npm run build:library",
    "build:library": "node scripts/build.mjs --library-only",
    "audit:public": "node scripts/audit-public.mjs",
    "test:integration": "node --test tests/integration-check.test.mjs tests/adoption-audit.test.mjs tests/browser-config.test.mjs",
    "test:public-install": "node scripts/verify-public-install.mjs",
    "docs:generate": "node scripts/component-catalog.mjs",
    "docs:check": "node scripts/component-catalog.mjs --check",
    "check:library": "node scripts/check-library.mjs",
    "audit:adoption": "node scripts/audit-adoption.mjs",
    "reference:build": "node scripts/build-catalog.mjs",
    "site:build": "node scripts/build-site.mjs",
    "test:reference": "node scripts/verify-reference.mjs",
    "format:check": "prettier --check src/components examples/catalog \"scripts/{component-catalog,audit-adoption,check-library,build-catalog,build-site,verify-reference}.mjs\"",
    "check": "npm run lint && npm run test:unit && npm run typecheck && npm run build:library && npm run docs:check && npm run check:library && npm run format:check && npm run test:namespace && npm run test:integration",
    "ci": "npm run check && npm run test:package-contract && npm run test:package && npm run site:build && npm run test:reference && npm test && npm run test:demo && npm run test:polish && npm run test:input && npm run test:menus && npm run test:composer && npm run test:composer-reference && npm run test:composer-integration && npm run test:chat-workspace && npm run test:ai && npm run test:scroll-edge-fade && npm run test:action-layout && npm run test:list-spacing && npm run test:tables && npm run test:record-actions && npm run test:icons && npm run test:notifications && npm run skill:package && npm run skill:check && npm run audit:public && npm run test:settings-profile && npm run test:window-shell && npm run test:temporal && npm run test:context-drop && npm run test:dialog-search",
    "test:tables": "node scripts/verify-tables.mjs",
    "test:ai": "node scripts/verify-ai.mjs",
    "test:scroll-edge-fade": "node scripts/verify-scroll-edge-fade.mjs",
    "test:notifications": "node scripts/verify-notifications.mjs",
    "lint": "eslint src --max-warnings=0",
    "test:package-contract": "node scripts/verify-package-contract.mjs",
    "test:package": "node scripts/verify-tarball.mjs",
    "prepublishOnly": "npm run check && npm run test:package",
    "test:unit": "vitest run --dir src/components --maxWorkers=1",
    "test:visual": "node scripts/verify-visual.mjs",
    "test:window-shell": "node scripts/verify-window-shell.mjs",
    "test:visual:update": "node scripts/verify-visual.mjs --update",
    "test:settings-profile": "node scripts/verify-settings-profile.mjs",
    "test:action-layout": "node scripts/verify-action-layout.mjs",
    "test:context-drop": "node scripts/verify-context-drop.mjs",
    "test:chat-workspace": "node scripts/verify-chat-workspace.mjs",
    "test:composer-reference": "node scripts/verify-composer-reference.mjs",
    "test:composer-model-modes": "node scripts/verify-composer-model-modes.mjs",
    "test:dialog-search": "node scripts/verify-dialog-search.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tanstack/react-virtual": "3.13.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "0.487.0",
    "react-day-picker": "9.14.0",
    "react-markdown": "10.1.0",
    "react-remove-scroll": "2.7.2",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/parser": "8.71.1",
    "esbuild": "0.25.12",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "postcss": "8.5.29",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuminxin45/ChatGPT-Desktop-UI.git"
  },
  "homepage": "https://liuminxin45.github.io/ChatGPT-Desktop-UI/",
  "bugs": {
    "url": "https://github.com/liuminxin45/ChatGPT-Desktop-UI/issues"
  },
  "keywords": [
    "react",
    "desktop",
    "ui",
    "components",
    "chatgpt",
    "accessibility"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
